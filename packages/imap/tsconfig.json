{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No `wrangler types` here: this package is a library, not a worker, so it
    // has no bindings of its own. The Workers globals it does use (fetch-style
    // streams, TextDecoder, `cloudflare:sockets` via cf-imap) come from
    // @cloudflare/workers-types.
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
