{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "imap-mcp-sync",
  "main": "src/index.ts",
  // Pinned to the newest date the toolchain actually runs: the workerd bundled
  // with @cloudflare/vitest-pool-workers caps out here, and a later date makes
  // every test fail to boot rather than fail a check. Move it forward only
  // together with that dependency.
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // `logs.invocation_logs` groups every console.log/error emitted during a run
  // into a single timeline in the dashboard (Workers & Pages -> this worker ->
  // Logs) -- the "breadcrumbs" behind an error, at 100% sampling.
  // `upload_source_maps` makes `wrangler deploy` bundle real source maps so
  // exception stack traces in that dashboard resolve back to this TypeScript,
  // not minified/bundled JS.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 }
  },
  "upload_source_maps": true,
  // Background cron worker with no public routes. workers_dev must stay false:
  // without it the worker is also live at <name>.<account>.workers.dev, which
  // would expose a worker holding full mailbox credentials on the open
  // internet. preview_urls does the same for versioned preview deploys.
  "workers_dev": false,
  "preview_urls": false,
  // The index both workers share. One database: the sync worker writes it, the
  // MCP server reads it.
  //
  // No `database_id` is committed, and that is not an omission. Wrangler
  // provisions a binding that has no resource id -- `wrangler dev` creates it
  // locally, `wrangler deploy` creates it on the account, links it, and writes
  // the id back into this file. It is also what a "Deploy to Cloudflare" button
  // does server-side. So this repo stays free of account-specific values while
  // still declaring everything a deploy needs.
  //
  // Two things to know when you deploy (see README.md):
  //   - Both workers must end up on the SAME database. Provisioning them
  //     independently creates two. Deploy this worker first, then point
  //     imap-mcp-server at the database this deploy created.
  //   - The id wrangler writes back into this committed file is yours. Don't
  //     push it upstream.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imap-mcp",
      // Repo root, shared by both workers -- one schema, two consumers.
      "migrations_dir": "../../migrations"
    }
  ],
  // Hourly, on the hour. Cron is UTC but the cadence is timezone-agnostic.
  "triggers": { "crons": ["0 * * * *"] }
  //
  // Not committed, and deliberately absent until the tickets that need them:
  //   account_id  -- set CLOUDFLARE_ACCOUNT_ID in your environment instead
  //   queues, r2_buckets -- #6, #9
  //
  // Nor is a `vars` block, which is why src/env.d.ts declares the shape
  // instead: the mailbox host and user identify one person's account, and this
  // file is committed to a public repository. Add them at deploy time (see
  // ../../.env.example):
  //   IMAP_HOST, IMAP_PORT, IMAP_USER  -- the mailbox
  //   SYNC_FOLDER                      -- folder to sync; defaults to Archive
  //   SYNC_BATCH_SIZE, SYNC_CHUNK_SIZE -- uids per run, messages per fetch
  //
  // Secrets (set with `pnpm exec wrangler secret put`):
  //   IMAP_PASSWORD -- app-specific password, full mailbox access incl. SMTP send
}
