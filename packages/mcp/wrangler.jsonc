{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "imap-mcp-server",
  "main": "src/index.ts",
  // Pinned to the newest date the toolchain actually runs: the workerd bundled
  // with @cloudflare/vitest-pool-workers caps out here, and a later date makes
  // every test fail to boot rather than fail a check. Move it forward only
  // together with that dependency.
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // `logs.invocation_logs` groups every console.log/error emitted during a
  // request into a single timeline in the dashboard (Workers & Pages -> this
  // worker -> Logs) -- the "breadcrumbs" behind an error, at 100% sampling.
  // `upload_source_maps` makes `wrangler deploy` bundle real source maps so
  // exception stack traces in that dashboard resolve back to this TypeScript,
  // not minified/bundled JS.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 }
  },
  "upload_source_maps": true,
  // No route is declared, and workers_dev + preview_urls are both false, so a
  // deploy of this worker is not reachable from the internet at all.
  //
  // Since #10 that is the second of two independent layers rather than the only
  // one. The worker verifies the Cloudflare Access JWT itself (src/access.ts)
  // and answers anything else with a 401, so a route added without an Access
  // application in front of it is a dead endpoint rather than an open mailbox.
  // Both layers stay: deleting the Access application must not silently open
  // this, and neither must adding a route.
  //
  // Without workers_dev: false the worker would be live at
  // <name>.<account>.workers.dev regardless of any route or Access policy — and
  // that hostname is not one an Access application covers.
  "workers_dev": false,
  "preview_urls": false,
  // The index both workers share. One database: the sync worker writes it, the
  // MCP server reads it.
  //
  // No `database_id` is committed, and that is not an omission. Wrangler
  // provisions a binding that has no resource id -- `wrangler dev` creates it
  // locally, `wrangler deploy` creates it on the account, links it, and writes
  // the id back into this file. It is also what a "Deploy to Cloudflare" button
  // does server-side. So this repo stays free of account-specific values while
  // still declaring everything a deploy needs.
  //
  // Two things to know when you deploy (see README.md):
  //   - Both workers must end up on the SAME database. Provisioning them
  //     independently creates two. Deploy imap-mcp-sync first, then point this
  //     worker at the database that deploy created.
  //   - The id wrangler writes back into this committed file is yours. Don't
  //     push it upstream.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imap-mcp",
      // Repo root, shared by both workers -- one schema, two consumers.
      "migrations_dir": "../../migrations"
    }
  ]
  //
  // Not committed, and deliberately absent until the tickets that need them:
  //   account_id  -- set CLOUDFLARE_ACCOUNT_ID in your environment instead
  //   routes      -- your own zone; see MCP_ZONE_NAME in ../../.env.example.
  //                  Create the Access application FIRST, then the route: a
  //                  route that exists before it answers 401 to everyone,
  //                  including you.
  //   vars        -- ACCESS_TEAM_DOMAIN / ACCESS_AUD, both required. Their
  //                  shape is declared in src/env.d.ts, the way packages/sync
  //                  declares its own; the values are yours and are added
  //                  here at deploy time. Without them the worker answers
  //                  500 rather than falling open. See ../../docs/access.md.
  //   r2_buckets  -- #9
  //   services    -- binding to imap-mcp-sync for writes (#12)
  //
  // This worker holds no IMAP credential, by design, and should never be given
  // one: writes reach the sync worker over a service binding instead.
}
