{
  "name": "@imap-mcp/mcp",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/deploy-config.mjs mcp && wrangler dev",
    "deploy": "node ../../scripts/deploy-config.mjs mcp && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "build": "wrangler deploy --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-istanbul": "^4.1.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8",
    "wrangler": "^4.105.0"
  }
}
