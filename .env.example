# Deployment configuration for imap-mcp.
#
# This repository is public, so none of the values below are committed —
# they identify one specific Cloudflare account, zone and Zero Trust tenant.
# Copy this file to `.env` (gitignored) and fill it in, or set the equivalents
# in your shell / CI before running wrangler.
#
# Nothing here is read by the workers at runtime. Runtime configuration is
# either a `vars` entry in the relevant packages/*/wrangler.jsonc (non-secret,
# added by you at deploy time) or a secret set with `wrangler secret put`.
# See "Configuration" in README.md.

# ---- Cloudflare account ----

# Your Cloudflare account ID (dashboard -> Workers & Pages -> Account details).
# wrangler reads this automatically, which is why no `account_id` is committed
# in either wrangler.jsonc.
CLOUDFLARE_ACCOUNT_ID=

# API token used by `wrangler deploy` from CI, if you deploy that way.
# Not needed for `wrangler deploy --dry-run`, which is all CI runs today.
CLOUDFLARE_API_TOKEN=

# ---- Route for the MCP worker ----
#
# packages/mcp/wrangler.jsonc deliberately declares NO route, and sets
# workers_dev + preview_urls to false, so a fresh deploy is unreachable from
# the internet. Add a `routes` entry naming your own zone when you are ready
# to expose it.
#
# Create the Access application FIRST, then the route. In that order the
# endpoint is never briefly open; in the other order it is never open either --
# the worker verifies the Access JWT itself, so a route without an application
# in front of it answers 401 to everyone, you included. Either way, the
# application's hostname and MCP_ROUTE_PATTERN must be the same hostname.

# The zone the MCP worker should be served from, e.g. example.com
MCP_ZONE_NAME=
# The hostname or path pattern to bind, e.g. mail-mcp.example.com
MCP_ROUTE_PATTERN=

# ---- Cloudflare Access (Managed OAuth) ----
#
# The MCP endpoint is read access to an entire mailbox, so it is gated by
# Cloudflare Access. The worker reads `ctx.access`, which the Workers runtime
# populates for a request Access authenticated, and compares its audience tag
# against the one value below. Add it as a `var` in
# packages/mcp/wrangler.jsonc once the Access application exists. IT IS
# REQUIRED: without it the worker answers 500, never an unauthenticated 200.
#
# docs/access.md is the step-by-step, and scripts/setup-access.sh walks it
# interactively. The parts that are easy to get wrong:
#
#   - MANAGED OAUTH IS OFF BY DEFAULT on a self-hosted application, and it is
#     the whole point. Zero Trust -> Access controls -> Applications -> your app
#     -> Advanced settings -> Managed OAuth. Without it a non-browser client
#     gets a 302 it cannot follow instead of a 401 it can act on, and every MCP
#     client simply fails to connect.
#   - The token Managed OAuth issues to the CLIENT is opaque ("oauth:...") and
#     the worker never sees it. Access exchanges it at the edge and hands the
#     result to the worker as `ctx.access`.
#   - For Claude Code, allow localhost and loopback redirect URIs.
#   - For claude.ai, allow https://claude.ai/api/mcp/auth_callback.
#
# No team domain is needed. The worker fetches no JWKS and parses no JWT, so
# there is nothing to point at <team>.cloudflareaccess.com.

# Application Audience (AUD) tag: Zero Trust -> Access -> Applications ->
# your app -> Overview -> "Application Audience Tag". Hex string.
#
# It must be THIS application's tag. Access authenticating someone is not the
# same as Access authenticating them for this application, and one Zero Trust
# account can hold many -- another of which may have a far more generous policy.
ACCESS_AUD=

# ---- Storage ----
#
# Nothing to fill in here, but worth knowing before your first deploy.
#
# The D1 binding in both packages/*/wrangler.jsonc carries a database_name
# ("imap-mcp") and deliberately NO database_id -- an id identifies one account,
# and this repo commits none. Wrangler provisions a binding with no id: it
# creates the database locally on `wrangler dev`, and on your account on
# `wrangler deploy`, then writes the id back into that wrangler.jsonc.
#
# Two consequences:
#   - Both workers must end up on the SAME database. Deploy imap-mcp-sync
#     first; then point imap-mcp-server at the database that deploy created,
#     rather than letting it provision a second one.
#   - The id wrangler writes back lands in a committed file. It is yours; don't
#     push it upstream.
#
# Apply the schema with `pnpm run db:migrate:local` / `db:migrate:remote`.
#
# The two queues (imap-mcp-sync-chunks and its dead-letter queue) are declared
# in packages/sync/wrangler.jsonc by name only and are created by
# `wrangler deploy`. Queues requires a Workers Paid plan.

# ---- Mailbox ----
#
# Host and port are configuration, not constants: this server is generic and
# only happens to be run against iCloud. IMAP_USER is not a secret but is
# personal, so it is documented here rather than committed.

# e.g. imap.mail.me.com for iCloud
IMAP_HOST=
# 993 (implicit TLS)
IMAP_PORT=993
# Full email address. For iCloud, LOGIN wants the local part only -- see README.
IMAP_USER=

# ---- What the sync worker indexes ----
#
# Also `vars` in packages/sync/wrangler.jsonc. Every one has a default, so the
# worker runs without them; the first is worth choosing deliberately and the
# rest are the throttles on a backfill.

# Folders to sync, comma-separated. Defaults to Archive, and that default is
# the point: on iCloud the mail is in Archive, not INBOX -- a spike found INBOX
# holding a single-digit message count against Archive's tens of thousands.
# Comma-separated because a folder name can contain almost anything else,
# including the hierarchy delimiter: SYNC_FOLDERS=Archive,Sent,Lists/rust-dev
SYNC_FOLDERS=Archive

# Uids per queue message. Default 100. This is the number that keeps a backfill
# to a few hundred LOGINs instead of tens of thousands: work is chunked by uid
# RANGE, never per message. It is also the bucket size the "what is already
# indexed?" query counts in, so changing it moves every bucket boundary and
# re-enqueues the folder once. The upsert makes that wasteful, not wrong.
SYNC_CHUNK_UIDS=100

# How many messages are fetched in one FETCH. This is what bounds peak memory:
# attachments are decoded into memory by the parse and a Worker has ~128 MB.
# Default 10.
SYNC_CHUNK_SIZE=10

# Uids per enumeration SEARCH. Default 5000. Bounds the size of the response
# iCloud sends back and the wall clock of a single cron invocation.
SYNC_ENUMERATE_WINDOW=5000

# How many ranges one cron tick may queue, across all folders -- the throttle
# on a backfill. Default 50, so ~5000 messages an hour at the defaults above. A
# large folder therefore completes over several ticks. The ceiling is divided
# evenly between folders, so the first cannot starve the rest.
SYNC_MAX_CHUNKS_PER_RUN=50

# Optional ISO date. When set, only mail received on or after it is indexed --
# useful when a mailbox has a known floor. Dates are the only SEARCH criterion
# besides uid ranges that this worker will ever use: a spike found size and
# string criteria unusable against iCloud (LARGER matches everything, SMALLER
# nothing, and SUBJECT/TEXT/FROM return no hits at all).
# SYNC_SINCE=2022-03-01

# ---- Secrets ----
#
# Never put these in a wrangler.jsonc `vars` block: that file is committed.
# Set them per worker with `pnpm exec wrangler secret put <NAME>`, and locally
# in packages/<worker>/.dev.vars (gitignored -- copy .dev.vars.example).
#
#   IMAP_PASSWORD  (packages/sync)  App-specific password. This grants FULL
#                                   mailbox access including SMTP send, so it
#                                   lives in exactly one worker and never
#                                   reaches a log line.
