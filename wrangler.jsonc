{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imap-mcp",
  "main": "src/index.ts",
  // Pinned to the newest date the toolchain actually runs: the workerd bundled
  // with @cloudflare/vitest-pool-workers caps out here, and a later date makes
  // every test fail to boot rather than fail a check. Move it forward only
  // together with that dependency.
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // `logs.invocation_logs` groups every console.log/error emitted during a run
  // into a single timeline in the dashboard (Workers & Pages -> this worker ->
  // Logs) -- the "breadcrumbs" behind an error, at 100% sampling.
  // `upload_source_maps` makes `wrangler deploy` bundle real source maps so
  // exception stack traces in that dashboard resolve back to this TypeScript,
  // not minified/bundled JS.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 }
  },
  "upload_source_maps": true,
  // Reachable by default, and deliberately so (#34): a one-click deploy needs
  // an address, and with one Worker there is no unreachable background half to
  // protect. This is a reduction from two independent layers to one -- the
  // authentication gate (src/mcp/auth.ts) is what holds the line: every
  // request needs the MCP_API_KEY secret as a bearer token, or Cloudflare
  // Access once ACCESS_AUD is set (#35). preview_urls stays false: a
  // versioned preview URL is a second hostname nobody asked for.
  "workers_dev": true,
  "preview_urls": false,
  // The unconfigured case is guarded here, at deploy time, not at runtime
  // (#35): `wrangler deploy` and `wrangler versions upload` fail, listing the
  // missing names, until both secrets are set — so an unauthenticated instance
  // is not a state a deploy can reach, and `wrangler types` generates both as
  // non-optional so the code cannot branch on their absence. ACCESS_AUD is
  // deliberately NOT here: it is the optional upgrade (see src/mcp/auth.ts),
  // and it cannot exist before the Worker does.
  //
  // Generate an API key with:  openssl rand -base64 32
  "secrets": { "required": ["IMAP_PASSWORD", "MCP_API_KEY"] },
  // The knobs, at their defaults, so a deployed instance can be asked what it
  // is running rather than assumed to be running the code's fallbacks.
  //
  // What is here and what is not is one rule: a value that identifies nobody
  // is committed, a value that identifies someone is not. So the sizing
  // throttles and the log level live here, and IMAP_HOST, IMAP_USER,
  // SYNC_SINCE, DRAFT_FROM, DRAFTS_FOLDER and ACCESS_AUD do not -- they name
  // one person's mailbox or one Zero Trust application, and this file is
  // committed to a public repository. The mailbox pair -- IMAP_HOST and
  // IMAP_USER -- is asked for AT DEPLOY TIME instead, alongside the two
  // secrets: .dev.vars.example is the prompt list the "Deploy to Cloudflare"
  // button reads, and a secret is never committed and never deleted by a
  // deploy. The rest (SYNC_SINCE, DRAFT_FROM, DRAFTS_FOLDER, ACCESS_AUD) are
  // vars a deployer adds afterwards, in a fork's config or in the dashboard,
  // where `keep_vars` below keeps them. See docs/configuration.md.
  //
  // Every value here restates the default in src/sync/config.ts, so this block
  // changes no behaviour -- what it changes is that `wrangler deploy` prints
  // them, the dashboard shows them, and GET /status reports them. A knob whose
  // value nobody can see is a knob nobody can debug.
  //
  // CHANGE THEM HERE, NOT IN THE DASHBOARD. Deploying sets every var in this
  // block, so a dashboard edit to one of THESE names is overwritten on the
  // next deploy. (`keep_vars` protects the names that are absent here, which
  // is the opposite case and the one that matters: your mailbox settings.)
  "vars": {
    // debug | info | warn | error | silent. See src/log.ts for what each
    // level says. `debug` is per-window and per-message, so it is loud in
    // proportion to the mailbox -- raise it to diagnose, then put it back.
    "LOG_LEVEL": "info",
    // 993, implicit TLS. The port is configuration rather than a constant
    // because this server is generic and only happens to run against iCloud.
    "IMAP_PORT": "993",
    // On iCloud the mail is in Archive, not INBOX. Comma-separated, because a
    // folder name can contain the hierarchy delimiter: "Archive,Lists/rust-dev".
    "SYNC_FOLDERS": "Archive",
    // Uids per queue message, and the bucket size gap detection counts in.
    // Changing it moves every bucket boundary and re-enqueues the folder once.
    "SYNC_CHUNK_UIDS": "100",
    // Messages per FETCH -- the count half of the peak-memory bound.
    "SYNC_CHUNK_SIZE": "10",
    // Uids per enumeration SEARCH.
    "SYNC_ENUMERATE_WINDOW": "5000",
    // Ranges one cron tick may queue, across all folders: the backfill
    // throttle, ~5000 messages an hour at these numbers.
    "SYNC_MAX_CHUNKS_PER_RUN": "50",
    // 8 MiB: the byte half of the peak-memory bound, and the ceiling on one
    // message. Above it a message is recorded from its headers as `oversize`.
    "SYNC_MAX_FETCH_BYTES": "8388608"
  },
  // Vars this file does not name are LEFT ALONE by a deploy.
  //
  // The default is the opposite -- `wrangler deploy` deletes every var it does
  // not carry -- and with the mailbox settings deliberately uncommittable
  // (above), that default is a trap: set IMAP_HOST in the dashboard, push
  // anything, and continuous deployment silently unconfigures the mailbox.
  // The instance keeps answering; the cron just stops finding a host, hourly,
  // for as long as nobody reads the logs. That is the failure this whole
  // change exists to make visible, so it is also worth simply preventing.
  //
  // The cost is drift: a var deleted from this block stays on the deployed
  // Worker until it is deleted in the dashboard too. GET /status reports the
  // values actually in effect, which is where a disagreement shows up.
  // Secrets are never touched by a deploy either way.
  "keep_vars": true,
  // The index. One database, one Worker: the sync half writes it, the MCP half
  // reads it.
  //
  // No `database_id` is committed, and that is not an omission. Wrangler
  // provisions a binding that has no resource id -- `wrangler dev` creates it
  // locally, `wrangler deploy` creates it on the account, links it, and writes
  // the id back into this file. It is also what a "Deploy to Cloudflare" button
  // does server-side. So this repo stays free of account-specific values while
  // still declaring everything a deploy needs. The id wrangler writes back into
  // your checkout is yours: keep it there, and never push it -- to a fork it
  // is a commit, to this repository an uncommitted local edit.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imap-mcp",
      "migrations_dir": "migrations"
    }
  ],
  // Attachment bytes (#9). D1 caps a single value at 2 MB, so the bytes cannot
  // live there whatever else were true; the metadata row in `attachments`
  // carries the key of the object here.
  //
  // Named and not identified, exactly like the D1 binding above: a bucket name
  // is scoped to an account rather than identifying one, so it is safe to
  // commit, and `wrangler deploy` provisions the bucket on first use. Only the
  // sync path writes it -- the MCP tools read attachment metadata and extracted
  // text out of D1, and nothing has yet needed to hand a model the bytes
  // themselves.
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "imap-mcp-attachments" }],
  // Hourly, on the hour. Cron is UTC but the cadence is timezone-agnostic.
  "triggers": { "crons": ["0 * * * *"] },
  // The fan-out (#6). The cron enumerates uids and posts ~100-uid ranges here;
  // this same worker consumes them, one range per invocation over one IMAP
  // connection. Both queues are created by `wrangler deploy`. Queues has been
  // on the Workers Free plan since 2026-02; what needs Workers Paid is the CPU
  // limit -- 10 ms free against 30 s paid, and parsing a message's MIME does
  // not fit in 10 ms. See docs/adr/0001-workers-paid-not-free-tier.md.
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "imap-mcp-sync-chunks" }],
    "consumers": [
      {
        "queue": "imap-mcp-sync-chunks",
        // One range per invocation. The handler loops the batch over a single
        // connection, so this can be raised without a code change.
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        // Low, and deliberately so. Queues will autoscale to hundreds of
        // parallel consumers; D1 is a single Durable Object and single
        // threaded, so high fan-out only relocates the bottleneck -- while
        // simultaneously opening hundreds of IMAP connections to one Apple
        // account. Nothing measured in the spike challenges 4-8.
        "max_concurrency": 4,
        "max_retries": 3,
        "retry_delay": 30,
        "dead_letter_queue": "imap-mcp-sync-dlq"
      },
      {
        // Consumed only to log what was missed: the message already carries
        // the folder and uid range, and re-running the backfill (#13) is the
        // recovery path. Without a consumer these would expire unread.
        "queue": "imap-mcp-sync-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_concurrency": 1,
        "max_retries": 0
      }
    ]
  }
  //
  // Not committed, and deliberately absent until the tickets that need them:
  //   account_id  -- set CLOUDFLARE_ACCOUNT_ID in your environment instead
  //   routes      -- your own zone, if you prefer a custom hostname over
  //                  workers.dev; see docs/configuration.md
  //
  // The `vars` block above carries the knobs. What it deliberately leaves out
  // is everything that identifies you, which src/env.d.ts declares the shape
  // of instead. IMAP_HOST and IMAP_USER are prompted for at deploy time (see
  // .dev.vars.example); these are the optional rest, added as vars in a fork's
  // config or in the dashboard (docs/configuration.md):
  //   IMAP_HOST, IMAP_USER  -- the mailbox. Without them the cron fails,
  //                            hourly and by name, in the logs
  //   SYNC_SINCE            -- optional ISO date floor
  //   DRAFT_FROM, DRAFTS_FOLDER -- only if create_draft needs them (#12)
  //   ACCESS_AUD            -- the optional Access upgrade (#35): set it
  //                            and Access is required, the API key refused
  //
  // The two required secrets are declared in `secrets` above and set with
  // `pnpm exec wrangler secret put` (or --secrets-file on a first deploy):
  //   IMAP_PASSWORD -- app-specific password, full mailbox access incl. SMTP send
  //   MCP_API_KEY   -- the bearer token MCP clients present in API-key mode
}
