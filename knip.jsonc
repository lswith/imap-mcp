{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/*": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    // The two workers' test suites import the workerd helpers from the
    // `cloudflare:test` module specifier, which knip reads as a package named
    // `cloudflare`. It is provided by the runtime, not by a dependency, so
    // there is nothing to install. packages/imap is left out deliberately: it
    // is a library with no bindings, so it never imports that module.
    "packages/sync": {
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/mcp": {
      "ignoreDependencies": ["cloudflare"]
    },
    // Types only, and no tests of its own: what it declares is checked by the
    // two packages that implement and consume it, which is the only place a
    // contract can be checked. See packages/writes/src/index.ts.
    "packages/writes": {
      "project": ["src/**/*.ts"]
    }
  }
}
