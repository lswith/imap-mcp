{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/*": {
      "project": ["src/**/*.ts", "test/**/*.ts"],
      // The workerd test helpers are imported from the `cloudflare:test` module
      // specifier, which knip reads as a package named `cloudflare`. It is
      // provided by the runtime, not by a dependency, so there is nothing to
      // install.
      "ignoreDependencies": ["cloudflare"]
    }
  }
}
